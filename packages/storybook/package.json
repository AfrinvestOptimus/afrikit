{
  "name": "afrikit-storybook",
  "version": "0.0.0",
  "private": true,
  "description": "Expo + Storybook harness for developing and reviewing afrikit-mobile components.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "storybook": "STORYBOOK_ENABLED=1 expo start",
    "storybook:ios": "STORYBOOK_ENABLED=1 expo start --ios",
    "storybook:android": "STORYBOOK_ENABLED=1 expo start --android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/core": "^7.25.2",
    "@expo-google-fonts/manrope": "^0.2.3",
    "@gorhom/bottom-sheet": "^4.6.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "^8.2.0",
    "@react-native-community/slider": "4.5.2",
    "@storybook/addon-ondevice-actions": "^7.6.20",
    "@storybook/addon-ondevice-controls": "^7.6.20",
    "@storybook/react-native": "^7.6.20",
    "@types/react": "~18.2.79",
    "afrikit-mobile": "1.1.1",
    "afrikit-shared": "^1.0.23",
    "expo": "~51.0.28",
    "expo-constants": "~16.0.2",
    "expo-font": "~12.0.9",
    "expo-status-bar": "~1.12.1",
    "nativewind": "^4.2.1",
    "react": "18.2.0",
    "react-hook-form": "^7.53.0",
    "react-native": "0.74.5",
    "react-native-flash-message": "^0.4.2",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-remix-icon": "^4.7.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-svg": "15.2.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^3.4.12",
    "typescript": "~5.3.3"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.24.7",
    "babel-preset-expo": "~11.0.0"
  }
